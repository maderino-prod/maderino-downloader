<?xml version="1.0" encoding="utf-8"?>
<!-- __VERSION__ est remplace par le workflow GitHub Actions (voir README.md). -->
<installer-gui-script minSpecVersion="2">
    <title>Maderino Downloader – Plugin Premiere Pro __VERSION__</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.maderino.premiere.downloader.installer"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.maderino.premiere.downloader.installer" visible="false">
        <pkg-ref id="com.maderino.premiere.downloader.installer"/>
    </choice>
    <pkg-ref id="com.maderino.premiere.downloader.installer" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
